# ==============================================================================
# Mihiracle Environment Configuration
# ==============================================================================

# Server Port
PORT=3001

# AI Provider Configuration (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Internet Web Search Provider (tavily, exa, duckduckgo, or demo)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here

# Supabase Server-side (Database & Admin Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client-Side Supabase (Public - Safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mode Configuration (Set to true to force demo mode even if keys exist)
FORCE_DEMO_MODE=false
